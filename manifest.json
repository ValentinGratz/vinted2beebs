{
  "manifest_version": 3,
  "name": "Vinted → Beebs",
  "version": "3.0.0",
  "description": "Fix CORS + vraies photos + vraie description",
  "permissions": ["storage"],
  "host_permissions": ["https://*.vinted.fr/*", "https://*.vinted.net/*", "https://*.beebs.app/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.vinted.fr/*", "https://*.vinted.net/*", "https://*.beebs.app/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "src/popup.html" }
}
