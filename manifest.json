{
  "manifest_version": 3,
  "name": "Vinted → Beebs",
  "version": "2.1.1",
  "description": "Fix CORS + URL /fr/listing",
  "permissions": ["storage"],
  "host_permissions": ["https://images*.vinted.net/*", "https://*.beebs.app/*", "https://www.beebs.app/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.vinted.fr/*", "https://*.beebs.app/*", "https://www.beebs.app/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "src/popup.html" }
}
