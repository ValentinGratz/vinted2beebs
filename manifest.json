{
  "manifest_version": 3,
  "name": "Vinted \u2192 Beebs - Export en 1 clic",
  "version": "1.0.0",
  "description": "Exporte tes annonces Vinted vers Beebs (Beebs by Kiabi) en 1 clic. Titre, description, prix, photos.",
  "icons": {
    "16": "src/icon16.png",
    "48": "src/icon48.png",
    "128": "src/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.fr/*",
        "https://www.vinted.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "clipboardWrite",
    "downloads"
  ],
  "host_permissions": [
    "https://*.vinted.fr/*",
    "https://*.vinted.com/*",
    "https://www.beebs.app/*"
  ],
  "action": {
    "default_title": "Vinted \u2192 Beebs",
    "default_popup": "src/popup.html"
  }
}